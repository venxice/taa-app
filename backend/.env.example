# ============================================================
# Backend Environment Variables
# ============================================================

# Server
PORT=5001
NODE_ENV=development

# Database (MySQL)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/taa_v2"

# JWT
JWT_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-unique-random-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS (frontend URL)
CLIENT_URL="http://localhost:3000"

# File Uploads
UPLOAD_DIR="uploads"
MAX_FILE_SIZE=5242880
